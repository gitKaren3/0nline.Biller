@inject IImageService ImageService


@* Reusable company form — owns the company fields, the logo lifecycle, and the EditContext *@
@* so a host can render it inside any EditForm and still validate it. *@
@* Parent saves company record *@

<MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-3">Business details</MudText>

<EditForm @ref="_form" Model="@Model" Class="mt-2">
    <DataAnnotationsValidator />

    <MudGrid>
        <MudItem xs="12" sm="8" lg="7">
            <MudTextField Label="Business Name" Class="mt-3" ShrinkLabel="true"
                            @bind-Value="Model.Name" For="@(() => Model.Name)" />
        </MudItem>

        <MudItem xs="6" sm="4" lg="3">
            <MudTextField Label="Registration Number" Class="mt-3" ShrinkLabel="true"
                            @bind-Value="Model.Registration" For="@(() => Model.Registration)" />
        </MudItem>

        <MudItem xs="12" md="8">
            <MudTextField Label="Address" Class="mt-3" Lines="3" ShrinkLabel="true"
                            @bind-Value="Model.Address" For="@(() => Model.Address)" />
        </MudItem>

        <MudItem xs="0" md="4" style="padding:0px"> @* Row filler *@ </MudItem>

        <MudItem xs="12" md="6">
            <MudTextField Label="City" Class="mt-3" ShrinkLabel="true"
                            @bind-Value="Model.AddressCity" For="@(() => Model.AddressCity)" />
        </MudItem>

        <MudItem xs="6" md="2">
            <MudTextField Label="Postal Code" Class="mt-3" ShrinkLabel="true"
                            @bind-Value="Model.AddressCode" For="@(() => Model.AddressCode)" />
        </MudItem>

        <MudItem xs="0" md="4" style="padding:0px"> @* Row filler *@ </MudItem>

        <MudItem xs="12" md="7" lg="5">
            <MudTextField Label="Country" Class="mt-3" ShrinkLabel="true"
                            @bind-Value="Model.AddressCountry" For="@(() => Model.AddressCountry)" />
        </MudItem>

        <MudItem xs="6" md="5" lg="5" Class="mt-3">
            <PhoneNumberField @bind-Value="Model.PhoneNo"
                Label="Business Phone"
                For="@(() => Model.PhoneNo)" />
        </MudItem>

        <MudItem xs="12" sm="12" md="10" lg="5" Class="mt-3">
            <MudText>Business Logo</MudText>

            @if ( _showUpload || Model.LogoImageID == null )
            {
                 <MudStack Row="true" Spacing="2" Class="mb-2" Justify="Justify.FlexEnd">
                    @if (Model.LogoImageID != null)
                    {
                        <MudButton OnClick="CancelReplace" StartIcon="@Icons.Material.Filled.Clear">
                            <span>Cancel</span>
                        </MudButton>
                    }
                 </MudStack>
                 <MudPaper Class="pa-6 ma-2" Outlined="true">
                    <ImageUpload @ref="_logoUpload" T="Image"
                                    Category="Logo" Caption="My Business Logo"
                                    FileSelected="OnLogoSelected"
                                    FileCleared="OnLogoCleared" />
                </MudPaper>
            }
            else
            {
               <MudStack Row="true" Spacing="2" Class="mb-2" Justify="Justify.FlexEnd">
                    <MudButton OnClick="ShowUploader" StartIcon="@Icons.Material.Filled.SwapHoriz">Replace</MudButton>
                    <MudButton OnClick="RemoveLogo" StartIcon="@Icons.Material.Filled.Delete">Remove</MudButton>
               </MudStack>
               <MudPaper Class="pa-6 ma-2" Outlined="true">

                    <MudImage Src="@Model.LogoImage?.ResolvedUrl" Style="width:100%;" />
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
</EditForm>

@code {
    /// <summary>The company being edited. Two-way bound so the host can read the result.</summary>
    [Parameter, EditorRequired] public Company Model { get; set; } = default!;

    private EditForm? _form;
    private ImageUpload<Image>? _logoUpload;

    private bool _showUpload;
    private bool _logoSelected;

    /// <summary>
    /// A logo the user removed but whose Image row still exists server side. Carried until the
    /// commit succeeds so "Remove" doesn't leave an orphaned image behind.
    /// </summary>
    private int? _removedLogoId;

    /// <summary>
    /// Images the company used to point at. They are only retired after the company save
    /// succeeds: deleting them during the upload would leave the stored row pointing at a
    /// dead image if the save failed. A set because a failed save can be retried after a
    /// second replacement.
    /// </summary>
    private readonly HashSet<int> _pendingLogoCleanup = new();

    /// <summary>
    /// The model instance the picker state was derived from. Re-deriving the state on every
    /// parameter set used to tear the picker down when the host re-rendered (TenantForm flips
    /// _isSubmitting while saving, before it calls CommitLogoAsync) and the selected file was
    /// lost, so the upload was skipped silently. Only reset when the model itself changes.
    /// </summary>
    private Company? _stateModel;

    /// <summary>Exposes the EditContext so a host can validate this form alongside others.</summary>
    public EditContext? EditContext => _form?.EditContext;

    /// <summary>
    /// Called by the host AFTER the tenant is registered and the JWT is refreshed.
    /// Uploads the logo (now that tenantId is available) and records any replaced or
    /// removed image. Nothing is retired yet: the host calls <see cref="FinalizeLogoAsync"/>
    /// once the company row has actually been saved.
    /// </summary>
    public async Task<bool> CommitLogoAsync()
    {
        int? oldLogoId = _removedLogoId ?? Model.LogoImageID;
        bool uploaded = true;

        if (_logoSelected)
        {
            if (_logoUpload == null)
            {
                // The picker is gone, so the file the user chose is gone with it. Fail loudly:
                // returning success here persists a company pointing at a logo never uploaded.
                return false;
            }

            if (await _logoUpload.UploadAsync() is Image image)
            {
                Model.LogoImageID = image.ID;
                Model.LogoImage = image;
                _logoSelected = false;
                _showUpload = false;
                StateHasChanged();
            }
            else
            {
                uploaded = false;
            }
        }

        if (uploaded && oldLogoId.HasValue && oldLogoId != Model.LogoImageID)
            _pendingLogoCleanup.Add(oldLogoId.Value);

        return uploaded;
    }

    /// <summary>
    /// Retires the images the company no longer points at. Call this only after the company
    /// save succeeded; a failed save leaves the old image referenced and must not delete it.
    /// </summary>
    public async Task FinalizeLogoAsync()
    {
        if (_pendingLogoCleanup.Count == 0) return;

        int[] pending = _pendingLogoCleanup.ToArray();
        _pendingLogoCleanup.Clear();
        _removedLogoId = null;

        foreach (int imageId in pending)
        {
            // Remove the row and the file. A failure (already gone, still
            // referenced elsewhere) must not turn a completed company save into
            // a failed request; the worst case is an orphaned image.
            try
            {
                await ImageService.RemoveAndDeRegisterImageAsync(imageId);
            }
            catch
            {
                // Cleanup is best-effort.
            }
        }
    }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_stateModel, Model)) return;

        _stateModel = Model;
        _removedLogoId = null;
        _pendingLogoCleanup.Clear();
        _showUpload = Model.LogoImageID is not int id || id == 0;
        _logoSelected = false;
    }

    private void ShowUploader() => _showUpload = true;

    private void CancelReplace()
    {
        _showUpload = false;
        _logoSelected = false;
    }

    private void RemoveLogo()
    {
        _removedLogoId ??= Model.LogoImageID;
        Model.LogoImageID = null;
        Model.LogoImage = null;
        _logoSelected = false;
        _showUpload = true;
    }

    private void OnLogoSelected(string fileName) => _logoSelected = true;

    private void OnLogoCleared() => _logoSelected = false;

}
