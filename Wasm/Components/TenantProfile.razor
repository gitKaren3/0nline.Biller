@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IStringLocalizer<LocalResources> Localizer
@inject ITenantService TenantService
@inject ITierService TierService
@inject ICompanyService CompanyService
@inject IImageService ImageService
@inject IAuthenticationService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserSession UserSession
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@using System.Text.RegularExpressions

<MudForm @ref="_contactForm" Model="@contactmodel" FormName="Contact">
    <br />
    <MudText Typo="Typo.h6" Color="Color.Primary">Contact Details</MudText>

    <MudGrid>
        <MudItem xs="6" md="4">
            <MudTextField Label="First Name" Class="mt-3"
                          @bind-Value="contactmodel.FirstName" For="@(() => contactmodel.FirstName)" />
        </MudItem>
        <MudItem xs="6" md="4">
            <MudTextField xs="6" Label="Surname" Class="mt-3"
                          @bind-Value="contactmodel.Surname" For="@(() => contactmodel.Surname)" />
        </MudItem>
        <MudItem xs="12" md="8">
            <MudTextField Label="@Localizer["Email"]" Class="mt-3"
                          @bind-Value="contactmodel.Email" For="@(() => contactmodel.Email)" />
        </MudItem>
        <MudItem xs="0" md="4" style="padding:0px"> </MudItem>
        <MudItem xs="6" md="4">
            @* Pattern="^\+27\s\d{2}\s\d{3}\s\d{4}$" *@ 
            <PhoneNumberField Label="Cell Phone" Class="mt-3"                                                         
                            @bind-Value="contactmodel.CellPhoneStr"  />
        </MudItem>
        <MudItem xs="6" md="4">
            <MudTextField Label="Business Phone" Class="mt-3" 
                            Adornment="Adornment.Start"
                            AdornmentIcon="@Icons.Material.Filled.Phone"
                            InputType="InputType.Telephone"
                            @bind-Value="contactmodel.BusinessPhone" For="@(() => contactmodel.BusinessPhone)" />
        </MudItem>
       
    </MudGrid>
</MudForm>
<br /><br /><br />
<MudForm @ref="_companyForm" Model="@companymodel" FormName="Company">
         <MudText Typo="Typo.h6" Color="Color.Primary">Company Details</MudText>
    @* <MudButton OnClick="OnExpandCollapseCompanyClick" Variant="Variant.Text">
                <MudText Typo="Typo.h6" Color="Color.Tertiary"> Company Details (optional) </MudText >
            </MudButton>*@
    <MudCollapse Expanded="_companyexpanded">

        <MudGrid>
            <MudItem xs="12" md="8">
                <MudTextField Label="Company Name" 
                              @bind-Value="companymodel.Name" For="@(() => companymodel.Name)" />
            </MudItem>

            <MudItem xs="0" md="4" style="padding:0px"></MudItem>

            <MudItem xs="12" md="8">
                <MudTextField Label="Address" Class="mt-3" Lines="3"
                              @bind-Value="companymodel.Address" For="@(() => companymodel.Address)" />
            </MudItem>

            <MudItem xs="0" md="4" style="padding:0px"></MudItem>

            <MudItem xs="12" md="6">
                <MudTextField Label="City" Class="mt-3"
                              @bind-Value="companymodel.AddressCity" For="@(() => companymodel.AddressCity)" />
            </MudItem>
            
            <MudItem xs="6" md="2">
                <MudTextField Label="Postal Code" Class="mt-3"
                              @bind-Value="companymodel.AddressCode" For="@(() => companymodel.AddressCode)" />
            </MudItem>

            <MudItem xs="0" md="4" style="padding:0px"></MudItem>
            
            <MudItem xs="12" md="8">
                <MudTextField Label="Country" Class="mt-3"
                              @bind-Value="companymodel.AddressCountry" For="@(() => companymodel.AddressCountry)" />
            </MudItem>

            <MudItem xs="0" md="4" style="padding:0px"></MudItem>
            
            <MudItem xs="6" md="4">
                <MudTextField Label="Registration Number" Class="mt-3"
                              @bind-Value="companymodel.Registration" For="@(() => companymodel.Registration)" />
            </MudItem>

            
            <MudItem xs="6" md="4">
                <MudTextField Label="Phone" Class="mt-3 mb-6"
                              @bind-Value="companymodel.Phone" For="@(() => companymodel.Phone)" />
            </MudItem>

            <MudItem xs="0" md="4" style="padding:0px"></MudItem>

            <MudItem xs="12" md="8">
                <MudText>Company Logo</MudText>

                <MudPaper Class="pa-6 ma-2" Outlined="true">
                    <ImageUpload @ref="_logoUpload" T="Image"
                                 Category="Logo" Caption="My Company Logo"
                                 FileSelected="onLogoSelected" />

                
                </MudPaper>
            </MudItem>
        </MudGrid>
    </MudCollapse>
</MudForm>
<MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               ButtonType="ButtonType.Submit" Disabled="_isSubmitting"
               OnClick="onSubmit">
        @if (_isSubmitting)
        {
            <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
            <MudText>Busy</MudText>
        }
        else
        {

            <MudText>Save</MudText>

        }
    </MudButton>
</MudStack>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private MudForm? _contactForm;
    private MudForm? _companyForm;

    private ImageUpload<Image>? _logoUpload;
    IDictionary<int, string> tiers = new Dictionary<int, string>();
    byte tierId = 1;

    private bool _isNewRegistration = false;
    private bool _isSubmitting;
    private bool _LogoSelected = false;

    private Tenant tenantmodel = new();
    private Contact contactmodel = new();
    private Company companymodel = new();

    private Company? deletedcompany;

    bool _companyexpanded = true;

    protected override async Task OnInitializedAsync()
    {
        if (UserSession.UserId != null)
        {
            var result = await TierService.GetLookupAsync();
            if (result.Successful && result.Value != null)
            {
                 tiers = result.Value;
            }

            if (tiers.Count > 0)
            {
                tierId = (byte)tiers.Keys.First();
            }

            Result<Tenant?> tresult = new();
            if (UserSession.TenantId > 0)
            {
                tresult = await TenantService.GetOneAsync(UserSession.TenantId);
            }
            else
            {
                tresult = await TenantService.GetTenantByUserIdAsync(UserSession.UserId?.ToString()!);
            }

            if (tresult.Value is Tenant tenant)
            {
                tenantmodel = tenant;
                contactmodel = tenant.Contact ?? new Contact();
                companymodel = tenant.Company ?? new();
            }
            else
            {
                throw new InvalidOperationException($"Tenant not found for user {UserSession.UserId}");
            }
        }
    }

    private async Task onSubmit()
    {
        _isSubmitting = true;
        try
        {
            await _contactForm!.ValidateAsync();
            if (!_contactForm.IsValid) return;

            if (IsCompanyProvided())
            {
                await _companyForm!.ValidateAsync();
                if (!_companyForm.IsValid) return;
            }

            if (deletedcompany != null)
            {
                var Logo = companymodel.LogoImage;
               
                var deleteResult = await CompanyService.DeleteOrDeactivateAsync(companymodel.ID);
                if (!deleteResult.Successful)
                {
                    Snackbar.Add($"Failed to remove company: {deleteResult.Message}", Severity.Error);
                    return;
                }
                else if (Logo != null)
                {
                    // make sure the image is locatable
                    Logo.TenantID = tenantmodel.ID;
                    await ImageService.UpdateAsync(Logo);
                }
            }

            if (_LogoSelected && tenantmodel.Company != null && _logoUpload != null)
            {
                var uploadResult = await _logoUpload.UploadAsync();
                if (uploadResult is Image image)
                {
                    tenantmodel.Company.LogoImageID = image.ID;
                }
            }

            var tResult = await TenantService.UpdateAsync(tenantmodel);
            if (!tResult.Successful)
            {
                Snackbar.Add($"Save failed: {tResult.Message}", Severity.Error);
            }
            else
            {
                await OnSaved.InvokeAsync();
            }        

        }
        catch (Exception ex)
        {
            Snackbar.Add($"An unexpected error occurred: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
            Nav.NavigateTo("/");
        }
    }

    private async Task onClearCompany()
    {
        deletedcompany = companymodel;

        // Reset the company model to a fresh instance
        companymodel = new Company();

        // Null out the tenant’s company so it won’t be saved
        tenantmodel.CompanyID = null;
        tenantmodel.Company = null;

        // Reset the form state (optional, clears validation messages)
        await _companyForm!.ResetAsync();

        // Reset logo state
        _LogoSelected = false;
    }

    private bool IsCompanyProvided()
    {
        // If tenant already has a company, treat it as "provided"
        if (tenantmodel.Company != null)
            return true;

        // Otherwise, check if any fields were filled in
        return !string.IsNullOrWhiteSpace(companymodel.Name)
            || !string.IsNullOrWhiteSpace(companymodel.Address)
            || !string.IsNullOrWhiteSpace(companymodel.AddressCity)
            || !string.IsNullOrWhiteSpace(companymodel.AddressCode)
            || !string.IsNullOrWhiteSpace(companymodel.AddressCountry)
            || !string.IsNullOrWhiteSpace(companymodel.Registration)
            || companymodel.Phone.HasValue;
    }


    private void onLogoSelected(string fileName)
    {
        _LogoSelected = true;
    }

    private void onLogoCleared()
    {
        _LogoSelected = false;
    }

    private void OnExpandCollapseCompanyClick()
    {
        _companyexpanded = !_companyexpanded;
    }

    private void FormatPhone(ChangeEventArgs e)
    {
        var digits = Regex.Replace(e.Value?.ToString() ?? "", @"\D", "");
        // Ensure it starts with country code 27
        if (digits.StartsWith("27"))
            digits = "+" + digits;
        else if (digits.StartsWith("0"))
            digits = "+27" + digits.Substring(1);

        // Apply spacing: +27 82 123 4567
        if (digits.Length >= 5)
            digits = Regex.Replace(digits, @"(\+27)(\d{2})(\d{3})(\d{0,4})", "$1 $2 $3 $4").Trim();

        e.Value = digits;
    }

}
