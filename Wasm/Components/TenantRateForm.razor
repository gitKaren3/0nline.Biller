@inject IServiceProvider Services

@* Reusable tenant rate form — owns the rate fields and the EditContext so a host can render *@
@* it as an admin editor or as a step in the Get Started wizard. The host validates and saves. *@

<MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-3">Billing rate</MudText>

<EditForm @ref="_form" Model="@Model" OnValidSubmit="HandleValidSubmit" Class="mt-2">
    <DataAnnotationsValidator />

    <MudGrid>
        <MudItem xs="12" sm="6" lg="3">
            @* Bound through the nullable selection view so "not chosen" is empty, not 0,
               and [Required] on that property fires on blur as well as on submit. *@
            <MudSelect T="short?" Label="Rate type" Class="mt-3" ShrinkLabel="true"
                       Placeholder="Select a rate type"
                       Disabled="Disabled"
                       @bind-Value="Model.RateTypeSelection" For="@(() => Model.RateTypeSelection)">
                @foreach (var rateType in RateTypeOptions)
                {
                    <MudSelectItem T="short?" Value="@((short)rateType.Key)">@rateType.Value</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="6" lg="5">
            <TaxedAmountField Value="Model.RateIncl" ValueChanged="OnRateChanged"
                              ShowTax="ShowTax" TaxRate="TaxRate"
                              MinorUnits="MinorUnits" CurrencySymbol="@CurrencySymbol"
                              Label="Rate" Required="true" RequiredError="Enter a rate."
                              Disabled="Disabled" For="@(() => Model.RateIncl)" />
        </MudItem>

        <MudItem xs="12" sm="6" lg="2">
            <MudSelect T="int?" Label="Client (optional)" Class="mt-3" ShrinkLabel="true" Clearable="true"
                       Disabled="Disabled"
                       @bind-Value="Model.CompanyID" For="@(() => Model.CompanyID)">
                @foreach (var company in CompanyOptions)
                {
                    <MudSelectItem T="int?" Value="@company.Key">@company.Value</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="6" lg="2">
            <MudSelect T="int?" Label="Contact (optional)" Class="mt-3" ShrinkLabel="true" Clearable="true"
                       Disabled="Disabled"
                       @bind-Value="Model.ContactID" For="@(() => Model.ContactID)">
                @foreach (var contact in ContactOptions)
                {
                    <MudSelectItem T="int?" Value="@contact.Key">@contact.Value</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12">
            <MudTextField Label="Note (optional)" Class="mt-3" ShrinkLabel="true"
                          HelperText="A short caption when several rates share the same type and client."
                          Disabled="Disabled"
                          @bind-Value="Model.Note" For="@(() => Model.Note)" />
        </MudItem>
    </MudGrid>
</EditForm>

@if (Model.Active == false)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-4">
        This rate is archived. Its history is kept for the invoices that used it.
    </MudAlert>
}

@code {
    /// <summary>
    /// The tenant rate being captured. The form writes straight into this instance, so
    /// the host can read the result without a binding callback.
    /// </summary>
    [Parameter, EditorRequired] public TenantRate Model { get; set; } = default!;

    /// <summary>Optional lookups supplied by the host. When omitted, they are loaded from the registered services.</summary>
    [Parameter] public IReadOnlyDictionary<int, string>? RateTypes { get; set; }
    [Parameter] public IReadOnlyDictionary<int, string>? Companies { get; set; }
    [Parameter] public IReadOnlyDictionary<int, string>? Contacts { get; set; }

    /// <summary>Whether the tax breakdown is shown. The saved amount is always inclusive.</summary>
    [Parameter] public bool ShowTax { get; set; }
    [Parameter] public decimal TaxRate { get; set; }
    [Parameter] public int MinorUnits { get; set; } = 2;
    [Parameter] public string CurrencySymbol { get; set; } = "R";

    /// <summary>Locks the fields while the host is saving or while the step is not active.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Raised when the form is submitted from inside (Enter in a field). A host that owns
    /// the save button does not need it; a host that wants Enter-to-save wires it.
    /// </summary>
    [Parameter] public EventCallback OnValidSubmit { get; set; }

    private static readonly IReadOnlyDictionary<int, string> Empty = new Dictionary<int, string>();

    private EditForm? _form;

    private IReadOnlyDictionary<int, string> _rateTypes = Empty;
    private IReadOnlyDictionary<int, string> _companies = Empty;
    private IReadOnlyDictionary<int, string> _contacts = Empty;

    private bool _rateTypesLoaded;
    private bool _companiesLoaded;
    private bool _contactsLoaded;

    private IReadOnlyDictionary<int, string> RateTypeOptions => RateTypes ?? _rateTypes;

    // A lookup arrives keyed by id, so a picker would otherwise list clients in
    // creation order. With labels like "Jones, Harriet" that reads as random, so
    // entity lists sort by label. Rate types keep their table order: they are a
    // curated enum, not a list of rows the tenant created.
    private IEnumerable<KeyValuePair<int, string>> CompanyOptions
        => (Companies ?? _companies).OrderBy(o => o.Value, StringComparer.CurrentCultureIgnoreCase);

    private IEnumerable<KeyValuePair<int, string>> ContactOptions
        => (Contacts ?? _contacts).OrderBy(o => o.Value, StringComparer.CurrentCultureIgnoreCase);

    /// <summary>Exposes the EditContext so a host can validate this form alongside others.</summary>
    public EditContext? EditContext => _form?.EditContext;

    /// <summary>Runs field validation and reports the verdict. This is the host's save gate.</summary>
    public bool Validate() => EditContext?.Validate() == true;

    private void OnRateChanged(decimal? value) => Model.RateIncl = value;

    protected override async Task OnParametersSetAsync()
    {
        // A host may hand the lookups over after its own asynchronous load (the wizard
        // does), so check on every parameter set instead of only in OnInitializedAsync.
        // A host-supplied dictionary always wins and is never replaced.
        if (RateTypes is null && !_rateTypesLoaded)
        {
            _rateTypesLoaded = true;
            _rateTypes = await LookupAsync<IRateTypeService>(service => service.GetLookupAsync());
        }

        if (Companies is null && !_companiesLoaded)
        {
            _companiesLoaded = true;
            _companies = await LookupAsync<ICompanyService>(service => service.GetLookupAsync());
        }

        if (Contacts is null && !_contactsLoaded)
        {
            _contactsLoaded = true;
            _contacts = await LookupAsync<IContactService>(service => service.GetLookupAsync());
        }
    }

    private async Task<IReadOnlyDictionary<int, string>> LookupAsync<TService>(
        Func<TService, Task<Result<IReadOnlyDictionary<int, string>>>> lookup)
    {
        if (Services.GetService(typeof(TService)) is not TService service)
            return Empty;

        try
        {
            var result = await lookup(service);
            return result.Successful && result.Value != null ? result.Value : Empty;
        }
        catch
        {
            // A lookup that cannot load must not blank the form; the host can still save.
            return Empty;
        }
    }

    private Task HandleValidSubmit()
        => OnValidSubmit.HasDelegate ? OnValidSubmit.InvokeAsync() : Task.CompletedTask;
}
