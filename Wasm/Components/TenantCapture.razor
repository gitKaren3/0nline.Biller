@using System.ComponentModel.DataAnnotations
@inject ISnackbar Snackbar
@inject ITenantService TenantService
@inject ITierService TierService
@inject ICompanyService CompanyService
@inject IImageService ImageService
@inject IAuthenticationService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserSession UserSession

@* One screen for both onboarding and editing the profile. *@

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="my-8 d-block mx-auto" />
}
else
{
    <EditForm @ref="_contactForm" Model="@contactmodel" Class="mb-10" >
        <DataAnnotationsValidator />            
        <ContactCapture Model="@contactmodel" Title="Contact Details" />              
    </EditForm>


    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Row="true" AlignItems="AlignItems.Baseline" Spacing="1">
            <MudText Typo="Typo.h6" Color="Color.Primary">Business details</MudText>
            
        </MudStack>

        <MudStack Row="true" Spacing="0">
            @if (companymodel.ID > 0)
            {
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="OnClearCompany">
                    Remove
                </MudButton>
            }
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ToggleBusiness"
                        EndIcon="@(_businessExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)">
                @(_businessExpanded ? "Hide" : "Add now")
            </MudButton>
        </MudStack>
    </MudStack>

    <MudCollapse Expanded="_businessExpanded">
        <EditForm @ref="_businessForm" Model="@companymodel" OnValidSubmit="OnValidSubmit" Class="mt-2">
            <DataAnnotationsValidator />
           
            <MudGrid>
                <MudItem xs="12" sm="8" lg="7" >
                    <MudTextField Label="Business Name" Class="mt-3" ShrinkLabel="true"
                                    @bind-Value="companymodel.Name" For="@(() => companymodel.Name)" />
                </MudItem>

                <MudItem xs="6" sm="4" lg="3">
                    <MudTextField Label="Registration Number" Class="mt-3" ShrinkLabel="true"
                                    @bind-Value="companymodel.Registration" For="@(() => companymodel.Registration)" />
                </MudItem>

                <MudItem xs="12" md="8">
                    <MudTextField Label="Address" Class="mt-3" Lines="3" ShrinkLabel="true"
                                    @bind-Value="companymodel.Address" For="@(() =>companymodel.Address)" />
                </MudItem>

                <MudItem xs="0" md="4" style="padding:0px"> @* Row filler *@ </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField Label="City" Class="mt-3" ShrinkLabel="true"
                                    @bind-Value="companymodel.AddressCity" For="@(() => companymodel.AddressCity)" />
                </MudItem>

                <MudItem xs="6" md="2">
                    <MudTextField Label="Postal Code" Class="mt-3" ShrinkLabel="true"
                                    @bind-Value="companymodel.AddressCode" For="@(() => companymodel.AddressCode)" />
                </MudItem>

                <MudItem xs="0" md="4" style="padding:0px"> @* Row filler *@ </MudItem>

                <MudItem xs="12" md="7" lg="5">
                    <MudTextField Label="Country" Class="mt-3" ShrinkLabel="true"
                        @bind-Value="companymodel.AddressCountry" For="@(() => companymodel.AddressCountry)" />
                </MudItem>


                <MudItem xs="6" md="5" lg="5" Class="mt-3">
                    <PhoneNumberField @bind-Value="companymodel.PhoneNo"
                        Label="Business Phone"
                        For="@(() => companymodel.PhoneNo)" />
                </MudItem>


                <MudItem xs="12" md="8" Class="mt-3">
                    <MudText>Business Logo</MudText>

                    <MudPaper Class="pa-6 ma-2" Outlined="true">
                        <ImageUpload @ref="_logoUpload" T="Image"
                                        Category="Logo" Caption="My Business Logo"
                                        FileSelected="onLogoSelected"
                                        FileCleared="onLogoCleared" />
                    </MudPaper>
                </MudItem>
                
            </MudGrid>
        </EditForm>
    </MudCollapse>
    
    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-6">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                    OnClick="OnSubmit" Disabled="_isSubmitting">
            @if (_isSubmitting)
            {
                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                <MudText>Busy</MudText>
            }
            else
            {
                <MudText>@(Onboarding ? "Get started" : "Save")</MudText>
            }
        </MudButton>
    </MudStack>
}

@code {
    /// <summary>True for a brand new tenant: drives the wording and the post-save redirect.</summary>
    [Parameter] public bool Onboarding { get; set; }

    /// <summary>The already-resolved tenant, or null when there isn't one yet.</summary>
    [Parameter] public Tenant? Tenant { get; set; }

    [Parameter] public EventCallback<Tenant> OnSaved { get; set; }

    private EditForm? _contactForm;
    private EditForm? _businessForm;
    private ImageUpload<Image>? _logoUpload;

    private bool _loading = true;
    private bool _isSubmitting;
    private bool _businessExpanded = true;
    private bool _logoSelected;

    private Tenant tenantmodel = new();
    private Contact contactmodel = new();
    private Company companymodel = new();
    private Company? _removedCompany;

    protected override async Task OnInitializedAsync()
    {
        if (Tenant is { ID: > 0 } existing)
        {
            tenantmodel = existing;
            contactmodel = existing.Contact ?? new Contact();
            companymodel = existing.Company ?? new Company();

            // A started business section comes back open so nothing is half captured.
            _businessExpanded = existing.Company != null;
        }
        else
        {
            var email = await GetIdentityEmailAsync();
            contactmodel = new Contact { UserId = UserSession.UserId, Email = email };
            companymodel = new Company();

            tenantmodel = new Tenant() { 
                UserId = UserSession.UserId,
                Contact = contactmodel, 
                Company = companymodel  };

        }

        _loading = false;
    }

    /// <summary>
    /// The account already knows the signed-in address, so don't ask for it again.
    /// Only used when it actually looks like an email - Identity.Name may be a display name.
    /// </summary>
    private async Task<string?> GetIdentityEmailAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var name = state.User?.Identity?.Name;

        return string.IsNullOrWhiteSpace(name) || !name.Contains('@') ? null : name;
    }

    private void ToggleBusiness() => _businessExpanded = !_businessExpanded;


    private async Task OnSubmit()
    {
        if (_isSubmitting) return;

        _isSubmitting = true;

        if (_contactForm != null && _businessForm != null)
        {
            bool allvalid =  _contactForm.EditContext!.Validate()
                           & _businessForm.EditContext!.Validate();

            if (allvalid)
                await OnValidSubmit();
        }

        _isSubmitting = false;
    }

    private async Task OnValidSubmit()
    {
        try
        {
            var tierresult = await TierService.GetLookupAsync();

            string warnings = string.Empty;

            bool isNew = tenantmodel.ID <= 0;
            if (isNew && tierresult.Successful)
            {
                var tierId = tierresult.Value?.Min(k => k.Key);
                tenantmodel.TierID = Convert.ToInt16(tierId); 
            }

            var result = await TenantService.CreateOrUpdateAsync(tenantmodel);
            if (!result.Successful || result.Value is null)
            {
                Snackbar.Add(result.Message ?? "Save failed.", Severity.Error);
                return;
            }

            if (result.Value is Tenant savedtenant)
            { 
                UserSession.UpdateTenant(savedtenant.ID);

                // Only a tenant created on this click gets a subscription; a resumed one
                // must not be subscribed twice.
                if (isNew)
                {
                    var subResult = await AuthService.AddUserSubscriptionAsync(
                                        userId: UserSession.UserId?.ToString() ?? string.Empty,
                                        appId: UserSession.AppId,
                                        tenantId: savedtenant.ID,
                                        tierId: savedtenant.TierID);

                    if (subResult.IsFailed)
                    {
                        Snackbar.Add(subResult.Message ?? "Subscription add failed.", Severity.Error);
                        return;
                    }

                    // Refresh the token before anything else: TenancyMiddleware reads the
                    // tenantId claim to resolve the tenant server side.
                    if (!string.IsNullOrEmpty(subResult.Value?.Token)
                        && AuthStateProvider is _0nline.Biller.Wasm.Client.Auth.JwtAuthStateProvider jwtProvider)
                    {
                        await jwtProvider.NotifyUserAuthenticationAsync(subResult.Value.Token);
                    }
                }

                if (_logoSelected)
                {
                    await UpdateUploadedLogo(savedtenant.Company ?? companymodel);
                }
            }            

            await OnSaved.InvokeAsync(tenantmodel);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
    }

    /// <summary>
    /// Drops a saved business row, or clears the draft if it was never saved.
    /// </summary>
    private void OnClearCompany()
    {
        if (companymodel.ID > 0)
            _removedCompany = companymodel;

        companymodel = new Company();
        tenantmodel.Company = null;
        tenantmodel.CompanyID = null;
        _logoSelected = false;
        _businessExpanded = false;

        if (_businessForm != null)
            _businessForm.EditContext!.MarkAsUnmodified();
    }

    private async Task UpdateUploadedLogo(Company company)
    {
        int? OldLogoId = company.LogoImageID;
        
        if (_logoUpload != null && await _logoUpload.UploadAsync() is Image image)
        {
            company.LogoImageID = image.ID;
            await CompanyService.UpdateAsync(company);
        }

        if (OldLogoId.HasValue)
        {
            // remove the old logo 
            var oldLogo = await ImageService.GetOneAsync(OldLogoId.Value);
            if (oldLogo.Successful && oldLogo.Value is { })
            {
                var deleteResult = await ImageService.DeleteOrDeactivateAsync(oldLogo.Value.ID);
                if (!deleteResult.Successful)
                {
                    // TODO: Log a warning but don't block the save: the new logo will be uploaded and the old one will be orphaned.
                }
            }
        }
    }


    private void onLogoSelected(string fileName) => _logoSelected = true;

    private void onLogoCleared() => _logoSelected = false;
}
