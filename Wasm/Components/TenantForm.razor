@using System.ComponentModel.DataAnnotations
@inject ISnackbar Snackbar
@inject ITenantService TenantService
@inject IContactService ContactService
@inject ICompanyService CompanyService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserSession UserSession

@* Orchestrates the two-section tenant form: contact + company. *@

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="my-8 d-block mx-auto" />
}
else
{
    <EditForm @ref="_contactForm" Model="@contactmodel" Class="mb-10">
        <DataAnnotationsValidator />
        <ContactCapture Model="@contactmodel" Title="Contact Details" />
    </EditForm>

    <CompanyForm @ref="_companyCapture" Model="@companymodel" />

    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-6">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                    OnClick="OnSubmit" Disabled="_isSubmitting">
            @if (_isSubmitting)
            {
                <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                <MudText>Busy</MudText>
            }
            else
            {
                <MudText>@(Onboarding ? "Get started" : "Save")</MudText>
            }
        </MudButton>
    </MudStack>
}

@code {
    /// <summary>True while the tenant has no attached contact or company.</summary>
    [Parameter] public bool Onboarding { get; set; }

    /// <summary>The tenant created by the ensure step.</summary>
    [Parameter] public Tenant? Tenant { get; set; }

    [Parameter] public EventCallback<Tenant> OnSaved { get; set; }

    private EditForm? _contactForm;
    private CompanyForm? _companyCapture;

    private bool _loading = true;
    private bool _isSubmitting;

    private Tenant tenantmodel = new();
    private Contact contactmodel = new();
    private Company companymodel = new();

    protected override async Task OnInitializedAsync()
    {
        if (Tenant is { ID: > 0 } existing)
        {
            tenantmodel = existing;
            contactmodel = existing.Contact ?? new Contact { UserId = UserSession.UserId };
            companymodel = existing.Company ?? new Company();

            if (string.IsNullOrWhiteSpace(contactmodel.Email))
                contactmodel.Email = await GetIdentityEmailAsync();
        }
        else
        {
            // The page only renders the form after ensure; this is a safety net.
            contactmodel = new Contact
            {
                UserId = UserSession.UserId,
                Email = await GetIdentityEmailAsync()
            };
            companymodel = new Company();
            tenantmodel = new Tenant { UserId = UserSession.UserId };
        }

        _loading = false;
    }

    /// <summary>
    /// The account already knows the signed-in address, so don't ask for it again.
    /// Only used when it actually looks like an email - Identity.Name may be a display name.
    /// </summary>
    private async Task<string?> GetIdentityEmailAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var name = state.User?.Identity?.Name;

        return string.IsNullOrWhiteSpace(name) || !name.Contains('@') ? null : name;
    }

    private async Task OnSubmit()
    {
        if (_isSubmitting) return;

        _isSubmitting = true;

        if (_contactForm?.EditContext is { } contactContext
            && _companyCapture?.EditContext is { } companyContext)
        {
            bool allvalid = contactContext.Validate() & companyContext.Validate();

            if (allvalid)
                await OnValidSubmit();
        }

        _isSubmitting = false;
    }

    private async Task OnValidSubmit()
    {
        try
        {
            if (tenantmodel.ID <= 0)
            {
                Snackbar.Add("The workspace is not ready yet. Reload the page.", Severity.Error);
                return;
            }

            // The logo must be uploaded before the company row is written: the
            // upload sets LogoImageID on the model. The token already carries
            // the tenant id because ensure ran on page load.
            if (_companyCapture != null && !await _companyCapture.CommitLogoAsync())
            {
                Snackbar.Add(
                    "Company logo upload failed, so nothing was saved. Reselect the logo and try again.",
                    Severity.Error);
                return;
            }

            var contactSave = contactmodel.ID > 0
                ? await ContactService.UpdateAsync(contactmodel)
                : await ContactService.CreateAsync(contactmodel);

            if (!contactSave.Successful || contactSave.Value is not Contact savedContact)
            {
                Snackbar.Add(Describe(contactSave, "Contact details could not be saved."), Severity.Error);
                return;
            }
            contactmodel = savedContact;

            var companySave = companymodel.ID > 0
                ? await CompanyService.UpdateAsync(companymodel)
                : await CompanyService.CreateAsync(companymodel);

            if (!companySave.Successful || companySave.Value is not Company savedCompany)
            {
                Snackbar.Add(Describe(companySave, "Company details could not be saved."), Severity.Error);
                return;
            }

            // The update response carries LogoImageID but not the navigation
            // object, so keep the image the upload already resolved.
            savedCompany.LogoImage ??= companymodel.LogoImage;

            // The company row now points at the new (or no) logo, so the old image
            // is finally safe to retire.
            if (_companyCapture != null)
                await _companyCapture.FinalizeLogoAsync();

            companymodel = savedCompany;

            // Point the tenant at the rows it just saved. The server verifies that
            // both belong to this tenant; the client cannot attach someone else's.
            var attach = await TenantService.AttachProfileAsync(savedContact.ID, savedCompany.ID);
            if (!attach.Successful || attach.Value is not Tenant savedTenant)
            {
                Snackbar.Add(Describe(attach, "The profile could not be attached to the workspace."), Severity.Error);
                return;
            }

            tenantmodel = savedTenant;
            UserSession.UpdateTenant(savedTenant.ID);
            await OnSaved.InvokeAsync(savedTenant);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
    }

    private static string Describe(Result result, string fallback)
        => result.Errors.FirstOrDefault()
            ?? (!string.IsNullOrWhiteSpace(result.Message) ? result.Message : fallback);
}
