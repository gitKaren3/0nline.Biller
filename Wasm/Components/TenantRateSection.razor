@inject ITenantRateService RateService
@inject IRateTypeService RateTypeService
@inject ICompanyService CompanyService
@inject IContactService ContactService
@inject IServiceProvider Services
@inject ISnackbar Snackbar

@* The tenant's captured rates. Loads and saves itself, so it can stand alone on a page *@
@* or sit in a Get Started wizard as one step. Set ShowHeading=false when the host titles it. *@

@if (ShowHeading)
{
    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mb-3">Billing rates</MudText>
}

<MudText Typo="Typo.body2" Class="mb-4">
    Rates are captured, not edited. The standard rate applies to everyone; a client or
    contact rate takes precedence. Deleting a rate that has been used archives it instead.
</MudText>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="my-4 d-block mx-auto" />
}
else if (_loadError != null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="my-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText>@_loadError</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ReloadAsync">Try again</MudButton>
        </MudStack>
    </MudAlert>
}
else if (_editing)
{
    <MudPaper Outlined="true" Elevation="0" Class="pa-4">
        <TenantRateForm @ref="_form" Model="_model"
                        RateTypes="_rateTypes" Companies="_companies" Contacts="_contacts"
                        ShowTax="_showTax" TaxRate="_taxRate"
                        MinorUnits="_minorUnits" CurrencySymbol="@_currencySymbol"
                        Disabled="_saving" />
    </MudPaper>

    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
        <MudButton OnClick="CancelEdit" Disabled="_saving">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="SaveAsync" Disabled="_saving">
            @(_saving ? "Saving..." : "Capture rate")
        </MudButton>
    </MudStack>
}
else
{
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="flex-wrap">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                <MudButton Color="@(_showArchived ? Color.Default : Color.Primary)"
                           OnClick="@(() => _showArchived = false)">Current</MudButton>
                <MudButton Color="@(_showArchived ? Color.Primary : Color.Default)"
                           OnClick="@(() => _showArchived = true)">Archived</MudButton>
            </MudButtonGroup>

            @if (_issuerTaxRegistered)
            {
                <MudSwitch T="bool" @bind-Value="_showTax" Label="Show tax"
                           Color="Color.Primary" Size="Size.Small" />
            }
        </MudStack>

        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="Add">
            Add rate
        </MudButton>
    </MudStack>

    @if (!VisibleRates.Any())
    {
        <MudText Typo="Typo.body2" Class="mt-3">
            @(_showArchived
                ? "No archived rates."
                : "No current rates yet. Capture the rate you charge for your work.")
        </MudText>
    }
    else
    {
        <MudPaper Outlined="true" Elevation="0" Class="mt-3">
            @foreach (var group in Groups)
            {
                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="px-4 pt-3 pb-1">
                    @RateTypeName(group.Key)
                </MudText>

                @foreach (var rate in group)
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center"
                              Class="px-4 py-3">
                        <MudStack Spacing="0">
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.subtitle2">@ScopeLabel(rate)</MudText>
                                @if (rate.Active == false)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Default"
                                             Variant="Variant.Outlined">Archived</MudChip>
                                }
                            </MudStack>
                            <MudText Typo="Typo.body2">@Amount(rate)</MudText>
                            @if (!string.IsNullOrWhiteSpace(rate.Note))
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@rate.Note</MudText>
                            }
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                Captured @Captured(rate)
                            </MudText>
                        </MudStack>

                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            @if (_confirmRemoveId == rate.ID)
                            {
                                <MudText Typo="Typo.body2">Remove?</MudText>
                                <MudButton Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => RemoveAsync(rate))">Yes</MudButton>
                                <MudButton Size="Size.Small" OnClick="@(() => _confirmRemoveId = null)">No</MudButton>
                            }
                            else if (rate.Active != false)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                               aria-label="Remove rate"
                                               OnClick="@(() => _confirmRemoveId = rate.ID)" />
                            }
                        </MudStack>
                    </MudStack>

                    <MudDivider />
                }
            }
        </MudPaper>
    }
}

@code {
    /// <summary>Hide the section heading when the host page already provides one.</summary>
    [Parameter] public bool ShowHeading { get; set; } = true;

    private const string LoadErrorMessage = "We could not load your rates. Please try again.";

    private static readonly IReadOnlyDictionary<int, string> Empty = new Dictionary<int, string>();

    private List<TenantRate> _rates = new();
    private TenantRate _model = new();

    private IReadOnlyDictionary<int, string> _rateTypes = Empty;
    private IReadOnlyDictionary<int, string> _companies = Empty;
    private IReadOnlyDictionary<int, string> _contacts = Empty;

    private TenantSetting? _settings;
    private bool _issuerTaxRegistered;
    private bool _showTax;
    private bool _showArchived;
    private decimal _taxRate;
    private int _minorUnits = 2;
    private string _currencySymbol = "R";

    private TenantRateForm? _form;

    private bool _loading = true;
    private bool _saving;
    private bool _editing;
    private string? _loadError;
    private int? _confirmRemoveId;

    private IEnumerable<TenantRate> VisibleRates => _rates
        .Where(rate => _showArchived ? rate.Active == false : rate.Active != false);

    private IEnumerable<IGrouping<short, TenantRate>> Groups => VisibleRates
        .OrderBy(rate => RateTypeOrder(rate.RateTypeID))
        .ThenBy(PageRank)
        .ThenBy(ScopeLabel, StringComparer.CurrentCultureIgnoreCase)
        .ThenByDescending(rate => rate.CapturedOn)
        .ThenByDescending(rate => rate.ID)
        .GroupBy(rate => rate.RateTypeID);

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        _loadError = null;

        try
        {
            // The lookups are needed for the labels, not only for the form's selects.
            var ratesTask = RateService.GetAllAsync();
            var rateTypesTask = LookupAsync(() => RateTypeService.GetLookupAsync());
            var companiesTask = LookupAsync(() => CompanyService.GetLookupAsync());
            var contactsTask = LookupAsync(() => ContactService.GetLookupAsync());

            await Task.WhenAll(ratesTask, rateTypesTask, companiesTask, contactsTask);

            var result = await ratesTask;

            if (!result.Successful || result.Value is not TenantRate[] rates)
            {
                _loadError = Describe(result, LoadErrorMessage);
                return;
            }

            _rateTypes = await rateTypesTask;
            _companies = await companiesTask;
            _contacts = await contactsTask;

            var settingsService = Services.GetService(typeof(ITenantSettingService)) as ITenantSettingService;
            var settings = settingsService is null
                ? Result<TenantSetting>.None()
                : await settingsService.GetForTenantAsync();

            _settings = settings.Successful ? settings.Value : null;
            _taxRate = _settings?.DefaultTaxRate ?? 0m;
            _minorUnits = _settings?.CurrencyMinorUnits ?? 2;
            _currencySymbol = CurrencyCatalog.Default
                .Get(_settings?.CurrencyCode ?? "ZAR").Symbol;

            var tenantService = Services.GetService(typeof(ITenantService)) as ITenantService;
            var session = Services.GetService(typeof(UserSession)) as UserSession;
            var tenant = tenantService is not null && session?.TenantId > 0
                ? await tenantService.GetOneAsync(session.TenantId)
                : Result<Tenant?>.Success(null);

            _issuerTaxRegistered = tenant.Successful
                && tenant.Value?.Company?.TaxSchemeID is not null;
            _showTax = _issuerTaxRegistered;

            _rates = rates
                .OrderBy(rate => rate.Active == false ? 1 : 0)
                .ThenBy(rate => RateTypeOrder(rate.RateTypeID))
                .ThenBy(PageRank)
                .ThenBy(ScopeLabel, StringComparer.CurrentCultureIgnoreCase)
                .ThenByDescending(rate => rate.CapturedOn)
                .ToList();
        }
        catch (Exception ex)
        {
            _loadError = $"{LoadErrorMessage} ({ex.Message})";
        }
        finally
        {
            _loading = false;
        }
    }

    private void Add()
    {
        _confirmRemoveId = null;
        _model = new TenantRate();
        _editing = true;
    }

    private void CancelEdit()
    {
        _editing = false;
        _model = new TenantRate();
    }

    private async Task SaveAsync()
    {
        if (_saving) return;

        // The form owns the EditContext; the section owns the save.
        if (_form?.Validate() != true) return;

        _saving = true;

        try
        {
            var saved = await RateService.CreateAsync(_model);

            if (!saved.Successful)
            {
                Snackbar.Add(Describe(saved, "The rate could not be captured."), Severity.Error);
                return;
            }

            Snackbar.Add("Rate captured.", Severity.Success);
            _editing = false;
            _model = new TenantRate();

            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Capture failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RemoveAsync(TenantRate rate)
    {
        _confirmRemoveId = null;

        try
        {
            // The service hard-deletes when nothing references the rate and archives
            // when an invoice line still does.
            var result = await RateService.DeleteOrDeactivateAsync(rate.ID);

            if (!result.Successful)
            {
                Snackbar.Add(Describe(result, "That rate could not be removed."), Severity.Error);
                return;
            }

            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Remove failed: {ex.Message}", Severity.Error);
        }
    }

    private static async Task<IReadOnlyDictionary<int, string>> LookupAsync(
        Func<Task<Result<IReadOnlyDictionary<int, string>>>> load)
    {
        try
        {
            var result = await load();
            return result.Successful && result.Value != null ? result.Value : Empty;
        }
        catch
        {
            // A missing label must not stop the rates themselves from loading.
            return Empty;
        }
    }

    private string RateTypeName(short rateTypeId)
        => _rateTypes.TryGetValue(rateTypeId, out var name) ? name : $"Rate type {rateTypeId}";

    private int RateTypeOrder(short rateTypeId)
    {
        int index = _rateTypes.Keys.ToList().IndexOf(rateTypeId);
        return index >= 0 ? index : int.MaxValue;
    }

    private static int PageRank(TenantRate rate) => (rate.CompanyID, rate.ContactID) switch
    {
        (null, null) => 0,          // standard first
        (not null, null) => 1,      // company
        (null, not null) => 2,      // contact
        _ => 3                      // company + contact
    };

    /// <summary>What the rate is for, without repeating the rate type.</summary>
    private string ScopeLabel(TenantRate rate)
    {
        var parts = new List<string>();

        if (rate.CompanyID is int companyId && _companies.TryGetValue(companyId, out var company))
            parts.Add(company);

        if (rate.ContactID is int contactId && _contacts.TryGetValue(contactId, out var contact))
            parts.Add(contact);

        return parts.Count == 0 ? "Standard" : string.Join(" · ", parts);
    }

    private string Amount(TenantRate rate)
    {
        var incl = rate.RateIncl ?? 0m;
        var money = Money(incl);

        if (!_showTax || !_issuerTaxRegistered)
            return money;

        var tax = TaxMath.TaxFromInclusive(incl, _taxRate, _minorUnits);
        var excl = TaxMath.NetFromInclusive(incl, tax);

        return $"{money} · Excl {Money(excl)} + Tax {Money(tax)}";
    }

    private string Money(decimal value)
        => $"{_currencySymbol}{value.ToString("N" + Math.Clamp(_minorUnits, 0, 4))}";

    private string Captured(TenantRate rate)
        => rate.CapturedOn is DateTime captured
            ? captured.ToUniversalTime().ToString("d MMM yyyy HH:mm 'UTC'")
            : "—";

    private static string Describe(Result result, string fallback)
        => result.Errors.FirstOrDefault()
            ?? (!string.IsNullOrWhiteSpace(result.Message) ? result.Message : fallback);
}
