@inject IInvoiceService InvoiceService
@inject ITenantRateService TenantRateService
@inject IDialogService DialogService

<MudTable Items="@Invoice.InvoiceLines" Hover="true" Dense="true" Elevation="0"
          Class="@(IsDraft ? "invoice-lines-table invoice-lines-editable" : "invoice-lines-table")">
    <ColGroup>
        <col />
        <col style="width: 20%;" />
        <col style="width: 15%;" />
        @if (ShowTax)
        {
            <col style="width: 8%;" />
            <col style="width: 10%;" />
        }
        <col style="width: 120px;" />
        <col style="width: 75px;" />
        @if (IsDraft)
        {
            <col style="width: 20px;" />
        }
    </ColGroup>
    <HeaderContent>
        <MudTh>Description</MudTh>
        <MudTh>@(ShowTax ? "Rate (Excl)" : "Rate")</MudTh>
        <MudTh Style="padding-right:30px;">Rate type</MudTh>
        @if (ShowTax)
        {
            <MudTh Style="text-align:right">Tax</MudTh>
            <MudTh Style="text-align:right">Incl</MudTh>
        }
        <MudTh Style="text-align:right;padding-right:30px;">Qty</MudTh>
        <MudTh Style="text-align:right;padding-right:30px;">Total</MudTh>
        @if (IsDraft)
        {
            <MudTh></MudTh>
        }
    </HeaderContent>
    <RowTemplate Context="line">
        <MudTd DataLabel="Description" Style="padding-left:10px;">
            @if (IsDraft)
            {
                <MudTextField T="string" Required="true" RequiredError="Required."
                              @bind-Value="line.Description" />
            }
            else
            {
                <MudText>@line.Description</MudText>
            }
        </MudTd>

        <MudTd DataLabel="Rate">
            @if (IsDraft)
            {
                <MudStack Spacing="0">
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                        @if (!ShowTax)
                        {
                            <MudNumericField T="decimal?" Value="line.BilledRateIncl"
                                             ValueChanged="@(v => OnRateAmountChanged(line, v))"
                                             Min="0" Margin="Margin.Dense" Required="true"
                                             RequiredError="Required."
                                             Format="@($"N{MinorUnits}")" Class="pa-0" />
                        }
                        else
                        {
                            <MudNumericField T="decimal?" Value="LineExcl(line)"
                                             ValueChanged="@(v => OnExclChanged(line, v))"
                                             Min="0" Margin="Margin.Dense" Required="true"
                                             RequiredError="Required."
                                             Format="@($"N{MinorUnits}")" Class="pa-0" />
                        }
                        <QuickRateMenu Rates="Rates"
                                       ContactId="Invoice.IssuedToContactID"
                                       CompanyId="Invoice.CompanyID"
                                       RateTypes="RateTypes"
                                       Companies="Companies"
                                       Contacts="Contacts"
                                       CurrencySymbol="@CurrencySymbol"
                                       MinorUnits="MinorUnits"
                                       OnPick="@(rate => OnQuickRateAsync(line, rate))"
                                       OnNew="@((short? _) => AddRateAsync(line))" />
                    </MudStack>
                    @if (line.TenantRateID is int sourceId)
                    {
                        @if (SourceRateMismatch(line))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Error">
                                Source rate differs from this line.
                            </MudText>
                        }
                    }
                </MudStack>
            }
            else
            {
                @if (!ShowTax)
                {
                    <MudText>@Money(line.BilledRateIncl ?? 0m)</MudText>
                }
                else
                {
                    <MudText>@Money(LineExcl(line) ?? 0m)</MudText>
                }
            }
        </MudTd>

        <MudTd DataLabel="Rate type">
            @if (IsDraft)
            {
                <MudSelect T="short?" Clearable="true"
                           Value="line.RateTypeID"
                           ValueChanged="@(v => OnRateTypeChanged(line, v))">
                    @foreach (var rateType in RateTypes.OrderBy(type => type.Key))
                    {
                        <MudSelectItem T="short?" Value="@((short)rateType.Key)">
                            @rateType.Value
                        </MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <MudText>@RateTypeName(line.RateTypeID)</MudText>
            }
        </MudTd>

        @if (ShowTax)
        {
            <MudTd DataLabel="Tax" Style="text-align:right">
                <MudText>@Money(LineTax(line))</MudText>
            </MudTd>
            <MudTd DataLabel="Incl" Style="text-align:right">
                <MudText>@Money(line.BilledRateIncl ?? 0m)</MudText>
            </MudTd>
        }

        <MudTd DataLabel="Qty" Style="text-align:right;">
            @if (IsDraft)
            {
                <MudNumericField T="decimal?" Min="@(0.01m)" Step="@(0.25m)"
                                 Required="true" RequiredError="Required."
                                 Margin="Margin.Dense" Class="pa-0"
                                 @bind-Value="line.Qty" />
            }
            else
            {
                <MudText>@FormatQty(line.Qty)</MudText>
            }
        </MudTd>

        <MudTd DataLabel="Total" Style="text-align:right;">
            <MudText>@Money(LineAmount(line))</MudText>
        </MudTd>

        @if (IsDraft)
        {
            <MudTd Style="text-align:right;padding-left:0px;padding-right:2px;">
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                               aria-label="Remove line" OnClick="@(() => RemoveLine(line))" />
            </MudTd>
        }
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Class="pa-4">No line items yet.</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    [Parameter, EditorRequired] public Invoice Invoice { get; set; } = default!;
    [Parameter] public bool IsDraft { get; set; }
    [Parameter] public bool ShowTax { get; set; }
    [Parameter] public decimal TaxRate { get; set; }
    [Parameter] public int MinorUnits { get; set; } = 2;
    [Parameter] public string CurrencySymbol { get; set; } = "R";
    [Parameter] public List<TenantRate> Rates { get; set; } = new();
    [Parameter] public IReadOnlyDictionary<int, string> RateTypes { get; set; } = new Dictionary<int, string>();
    [Parameter] public IReadOnlyDictionary<int, string> Companies { get; set; } = new Dictionary<int, string>();
    [Parameter] public IReadOnlyDictionary<int, string> Contacts { get; set; } = new Dictionary<int, string>();
    [Parameter] public IReadOnlyDictionary<short, int> RateTypeMaxQty { get; set; } = new Dictionary<short, int>();
    [Parameter] public EventCallback OnChanged { get; set; }

    private string Money(decimal value) => $"{CurrencySymbol}{value.ToString("N" + MinorUnits)}";

    private static string FormatQty(decimal? qty) => (qty ?? 0m).ToString("0.##");

    private string RateTypeName(short? rateTypeId)
        => rateTypeId is short id && RateTypes.TryGetValue(id, out var name)
            ? name
            : "—";

    private decimal LineTaxRate(InvoiceLine line)
        => line.ID > 0
            ? line.TaxRate ?? 0m
            : (ShowTax ? TaxRate : 0m);

    private decimal LineTax(InvoiceLine line)
        => TaxMath.TaxFromInclusive(
            line.BilledRateIncl ?? 0m, LineTaxRate(line), MinorUnits);

    private decimal? LineExcl(InvoiceLine line)
    {
        if (line.BilledRateIncl is not decimal incl)
            return null;

        var tax = TaxMath.TaxFromInclusive(incl, LineTaxRate(line), MinorUnits);
        return TaxMath.NetFromInclusive(incl, tax);
    }

    private static decimal LineAmount(InvoiceLine line) => (line.BilledRateIncl ?? 0m) * (line.Qty ?? 0m);

    private bool SourceRateMismatch(InvoiceLine line)
    {
        if (line.TenantRateID is not int sourceId)
            return false;

        var rate = Rates.FirstOrDefault(candidate => candidate.ID == sourceId);
        return rate is null
            || rate.RateTypeID != line.RateTypeID
            || rate.RateIncl != line.BilledRateIncl;
    }

    private void OnRateAmountChanged(InvoiceLine line, decimal? value)
    {
        line.BilledRateIncl = value;
        line.TenantRateID = null;
        _ = OnChanged.InvokeAsync();
    }

    private void OnExclChanged(InvoiceLine line, decimal? value)
    {
        if (value is null)
        {
            line.BilledRateIncl = null;
            line.TenantRateID = null;
            _ = OnChanged.InvokeAsync();
            return;
        }

        line.BilledRateIncl = TaxMath.GrossFromNet(
            value.Value, LineTaxRate(line), MinorUnits);
        line.TenantRateID = null;
        _ = OnChanged.InvokeAsync();
    }

    private async Task OnQuickRateAsync(InvoiceLine line, TenantRate rate)
    {
        line.TenantRateID = rate.ID;
        line.RateTypeID = rate.RateTypeID;
        line.BilledRateIncl = rate.RateIncl;

        await PrefillQuantityAsync(line, overwrite: line.Qty is null or <= 0);
        await OnChanged.InvokeAsync();
    }

    private async Task OnRateTypeChanged(InvoiceLine line, short? rateTypeId)
    {
        if (line.RateTypeID == rateTypeId)
            return;

        line.RateTypeID = rateTypeId;

        if (line.TenantRateID is int sourceId)
        {
            var source = Rates.FirstOrDefault(rate => rate.ID == sourceId);
            if (source is null || source.RateTypeID != rateTypeId)
                line.TenantRateID = null;
        }

        if (rateTypeId is short type)
            await PrefillQuantityAsync(line, overwrite: true);

        await OnChanged.InvokeAsync();
    }

    private async Task PrefillQuantityAsync(InvoiceLine line, bool overwrite)
    {
        if (line.RateTypeID is not short rateTypeId)
            return;

        if (!overwrite && line.Qty is > 0)
            return;

        decimal? qty = null;

        try
        {
            var result = await InvoiceService.LastQuantityAsync(
                Invoice.IssuedToContactID, Invoice.CompanyID, rateTypeId, Invoice.ID);

            if (result.Successful)
                qty = result.Value;
        }
        catch
        {
            // History is a convenience; a failed lookup falls back to MaxQty/1.
        }

        if (qty is null
            && RateTypeMaxQty.TryGetValue(rateTypeId, out int maxQty)
            && maxQty > 0)
        {
            qty = maxQty;
        }

        line.Qty = qty ?? 1m;
        await OnChanged.InvokeAsync();
    }

    private async Task AddRateAsync(InvoiceLine line)
    {
        var parameters = new DialogParameters
        {
            [nameof(RateDialog.RateTypeID)] = line.RateTypeID,
            [nameof(RateDialog.ContactID)] = Invoice.IssuedToContactID > 0
                ? Invoice.IssuedToContactID
                : null,
            [nameof(RateDialog.CompanyID)] = Invoice.CompanyID,
            [nameof(RateDialog.RateIncl)] = line.BilledRateIncl,
            [nameof(RateDialog.RateTypes)] = RateTypes,
            [nameof(RateDialog.Companies)] = Companies,
            [nameof(RateDialog.Contacts)] = Contacts,
            [nameof(RateDialog.ShowTax)] = ShowTax,
            [nameof(RateDialog.TaxRate)] = TaxRate,
            [nameof(RateDialog.MinorUnits)] = MinorUnits,
            [nameof(RateDialog.CurrencySymbol)] = CurrencySymbol
        };

        var dialog = await DialogService.ShowAsync<RateDialog>(
            "Add a rate",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });

        var result = await dialog.Result;

        if (result is { Canceled: false, Data: TenantRate rate })
        {
            await RefreshRatesAsync();
            await OnQuickRateAsync(line, rate);
        }
    }

    private async Task RefreshRatesAsync()
    {
        var result = await TenantRateService.GetAllAsync();
        if (result.Successful && result.Value is TenantRate[] list)
        {
            Rates.Clear();
            Rates.AddRange(list);
        }
        await OnChanged.InvokeAsync();
    }

    private void RemoveLine(InvoiceLine line)
    {
        Invoice.InvoiceLines.Remove(line);
        _ = OnChanged.InvokeAsync();
    }

    private void AddLine()
    {
        Invoice.InvoiceLines.Add(new InvoiceLine { BilledRateIncl = 0m });
        _ = OnChanged.InvokeAsync();
    }
}