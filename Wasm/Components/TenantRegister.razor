@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IStringLocalizer<LocalResources> Localizer
@inject ITenantService TenantService
@inject ITierService TierService
@inject IAuthenticationService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserSession UserSession
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject System.Net.Http.IHttpClientFactory ClientFactory

@if (_wizardstep == RegistrationStep.Contact)
{
    <MudForm @ref="_contactForm" Model="@contactmodel" FormName="Contact">
   
        <MudText Typo="Typo.h6" Color="Color.Tertiary">Contact Details</MudText>
        <MudGrid>
            <MudItem xs="6" md="4">
                <MudTextField Label="First Name" Class="mt-3"
                              @bind-Value="contactmodel.FirstName" For="@(() => contactmodel.FirstName)" />
            </MudItem>
            <MudItem xs="6" md="4">
                <MudTextField xs="6" Label="Surname" Class="mt-3"
                              @bind-Value="contactmodel.Surname" For="@(() => contactmodel.Surname)" />
            </MudItem>
            <MudItem xs="12" md="8">
                <MudTextField Label="@Localizer["Email"]" Class="mt-3"
                              @bind-Value="contactmodel.Email" For="@(() => contactmodel.Email)" />
            </MudItem>
            <MudItem xs="0" md="4" style="padding:0px"> @* Row filler *@ </MudItem>
            <MudItem xs="6" md="4">
                <MudTextField Label="Cell Phone" Class="mt-3"
                              @bind-Value="contactmodel.CellPhone" For="@(() => contactmodel.CellPhone)" />
            </MudItem>
            <MudItem xs="6" md="4">
                <MudTextField Label="Business Phone" Class="mt-3"
                              @bind-Value="contactmodel.BusinessPhone" For="@(() => contactmodel.BusinessPhone)" />
            </MudItem>
        </MudGrid>
        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
            <MudButton  Variant="Variant.Filled" Color="Color.Primary"
                OnClick="onValidContactSubmit" Disabled="_isSubmitting">
                @if (_isSubmitting)
                {
                    <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                    <MudText>Busy</MudText>
                }
                else
                {
                    <MudText>Next</MudText>
                }
            </MudButton>
        </MudStack>

    </MudForm>
}
else if (_wizardstep == RegistrationStep.Company)
{
    <MudForm @ref="_companyForm" Model="@companymodel" FormName="Company">
        <MudText Typo="Typo.h6" Color="Color.Tertiary">Company Details (optional)</MudText>
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudTextField Label="Company Name"
                              @bind-Value="companymodel.Name" For="@(() => companymodel.Name)" />
            </MudItem>

            <MudItem xs="0" md="4" style="padding:0px"> @* Row filler *@ </MudItem>

            <MudItem xs="12" md="8">
                <MudTextField Label="Address" Class="mt-3" Lines="3"
                              @bind-Value="companymodel.Address" For="@(() => companymodel.Address)" />
            </MudItem>

            <MudItem xs="0" md="4" style="padding:0px"> @* Row filler *@ </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField Label="City" Class="mt-3"
                              @bind-Value="companymodel.AddressCity" For="@(() => companymodel.AddressCity)" />
            </MudItem>

            <MudItem xs="6" md="2">
                <MudTextField Label="Postal Code" Class="mt-3"
                              @bind-Value="companymodel.AddressCode" For="@(() => companymodel.AddressCode)" />
            </MudItem>

            <MudItem xs="0" md="4" style="padding:0px"> @* Row filler *@ </MudItem>

            <MudItem xs="12" md="8">
                <MudTextField Label="Country" Class="mt-3"
                              @bind-Value="companymodel.AddressCountry" For="@(() => companymodel.AddressCountry)" />
            </MudItem>

            <MudItem xs="0" md="4" style="padding:0px"> @* Row filler *@ </MudItem>

            <MudItem xs="6" md="4">
                <MudTextField Label="Registration Number" Class="mt-3"
                              @bind-Value="companymodel.Registration" For="@(() => companymodel.Registration)" />
            </MudItem>

            
            <MudItem xs="6" md="4">
                <MudTextField Label="Phone" Class="mt-3 mb-6"
                              @bind-Value="companymodel.Phone" For="@(() => companymodel.Phone)" />
            </MudItem>

            <MudItem xs="0" md="4" style="padding:0px"> @* Row filler *@ </MudItem>

            <MudItem xs="12" md="8">
                <MudText>Company Logo</MudText>

                <MudPaper Class="pa-6 ma-2" Outlined="true">
                    <ImageUpload @ref="_logoUpload" T="Image"
                                 Category="Logo" Caption="My Company Logo"
                                 FileSelected="onLogoSelected" />

                
                </MudPaper>
            </MudItem>
        </MudGrid>

        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">

            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="onValidCompanySubmit" Disabled="_isSubmitting" >
                @if (_isSubmitting)
                {
                    <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                    <MudText>Busy</MudText>
                }
                else
                {
                    <MudText>Save</MudText>
                }
            </MudButton>

            <MudButton Variant="Variant.Filled" Color="Color.Tertiary" OnClick="onCompleted">
                <MudText>Skip</MudText>
                <MudIcon Icon="@Icons.Material.Filled.SkipNext" />
            </MudButton>
        </MudStack>
    </MudForm>
}


@code {
    [Parameter] public EventCallback<Tenant> OnTenantCreated { get; set; }
    [Parameter] public EventCallback OnRegistrationCompleted { get; set; }

    private MudForm? _contactForm;
    private MudForm? _companyForm;

    // write an enum for the steps in the registration process:
    private enum RegistrationStep : byte
    {
        Contact = 1,
        Company = 2 
    }

    private ImageUpload<Image>? _logoUpload;
    IDictionary<int, string> tiers = new Dictionary<int, string>();
    byte tierId = 1;

    private RegistrationStep _wizardstep = RegistrationStep.Contact;
    private bool _isSubmitting;
    private bool _LogoSelected = false;


    private Tenant? tenantmodel = null;
    private Contact contactmodel = new();
    private Company companymodel = new();


    protected override async Task OnInitializedAsync()
    {
        if (UserSession.UserId != null)
        {
            var result = await TierService.GetLookupAsync();
            if (result.Successful && result.Value != null)
            {
                tiers = result.Value;
            }

            if (tiers.Count > 0)
            {
                tierId = (byte)tiers.Keys.First();
            }

            await FindTenant();

            contactmodel.UserId = UserSession.UserId;
        }
    }

    private async Task onValidContactSubmit()
    {

         await _contactForm!.ValidateAsync();
         if (!_contactForm.IsValid) return;

        _isSubmitting = true;
        try
        {

            if (tenantmodel == null)
            {
                // Create Tenant with embedded Contact information
                tenantmodel = new Tenant
                {
                    TierID = tierId,
                    UserId = UserSession.UserId,
                    ContactID = 0,  //required
                    Contact = contactmodel,
                    Company = null
                };
            }

            var tResult = await TenantService.CreateOrUpdateAsync(tenantmodel);
            if (tResult.Successful && tResult.Value is Tenant tenant)
            {
                tenantmodel = tenant;
                await OnTenantCreated.InvokeAsync(tenantmodel);
            }
            else
            {
                Snackbar.Add($"Save failed: {tResult.Message}", Severity.Error);
                return;
            }

            
            int tenantId = tenantmodel!.ID;
            UserSession.UpdateTenant(tenantId);

            var authResult = await AuthService.AddUserSubscriptionAsync(
                userId: UserSession?.UserId?.ToString()!,
                appId: UserSession?.AppId!,
                tenantId: tResult.Value!.ID,
                tierId: tierId
            );

            if (authResult.IsFailed)
            {
                Snackbar.Add($"{authResult.Message}", Severity.Error);
                return;
            }

            // 4. Update Token in Local Storage
            if (!string.IsNullOrEmpty(authResult.Value?.Token))
            {
                if (AuthStateProvider is _0nline.Biller.Wasm.Client.Auth.JwtAuthStateProvider jwtProvider)
                {
                    await jwtProvider.NotifyUserAuthenticationAsync(authResult.Value.Token);
                }
            }

            _wizardstep += 1;

        }
        catch (Exception ex)
        {
            Snackbar.Add($"An unexpected error occurred: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }


    private async Task onValidCompanySubmit()
    {
        await _companyForm!.ValidateAsync();
        if (!_companyForm.IsValid) return;

        if (tenantmodel == null)
            if (await FindTenant() == false)
            {
                Snackbar.Add($"Something went wrong, please try again", Severity.Error);
                _wizardstep -= 1;
                return;
            }


        if (_LogoSelected && _logoUpload != null)
        {
            var uploadResult = await _logoUpload.UploadAsync();
            if (uploadResult is Image image)
            {
                companymodel.LogoImageID = image.ID;
            }
        }

        tenantmodel!.Company = companymodel;

        var tResult = await TenantService.UpdateAsync(tenantmodel);
        if (!tResult.Successful)
        {
            Snackbar.Add($"Save failed: {tResult.Message}", Severity.Error);
            return;
        }
        else
        {
            Snackbar.Add("Registration completed successfully", Severity.Success); 
            await onCompleted();
        }
    }

    private async Task<bool> FindTenant()
    {
        Result<Tenant?> tresult = new();
        if (UserSession.TenantId > 0)
        {
            tresult = await TenantService.GetOneAsync(UserSession.TenantId);
        }
        else
        {
            tresult = await TenantService.GetTenantByUserIdAsync(UserSession.UserId?.ToString()!);
        }

        if (tresult.Value is Tenant tenant)
        {
            tenantmodel = tenant;
            contactmodel = tenant.Contact ?? new Contact();
            companymodel = tenant.Company ?? new();
            return true;
        }
        else
            return false;
    }

    private async Task onCompleted()
    {
        await OnRegistrationCompleted.InvokeAsync();
    }

    private void onLogoSelected(string fileName)
    {
        _LogoSelected = true;
    }

    private void onLogoCleared()
    {
        _LogoSelected = false;
    }

}
