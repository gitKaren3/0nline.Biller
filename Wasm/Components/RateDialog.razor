@inject ITenantRateService TenantRateService
@inject IRateTypeService RateTypeService
@inject ISnackbar Snackbar

@* A minimal rate capture for the invoice editor: choose a rate type and an amount.
   On success the dialog returns the created TenantRate so the caller can select it. *@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Add a rate</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm @ref="_form" Model="_model" OnValidSubmit="SaveAsync" Class="mt-2">
            <DataAnnotationsValidator />

            <MudSelect T="short?" Label="Rate type" Class="mt-3" ShrinkLabel="true"
                       Placeholder="Select a rate type"
                       @bind-Value="_model.RateTypeSelection"
                       For="@(() => _model.RateTypeSelection)">
                @foreach (var rateType in RateTypeOptions)
                {
                    <MudSelectItem T="short?" Value="@((short)rateType.Key)">@rateType.Value</MudSelectItem>
                }
            </MudSelect>

            <MudNumericField T="decimal?" Label="Rate" Class="mt-3" ShrinkLabel="true" Min="0"
                             @bind-Value="_model.DefaultRate" For="@(() => _model.DefaultRate)" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_saving">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving">
            @(_saving ? "Saving..." : "Add rate")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private readonly TenantRate _model = new() { StartDate = DateTime.Today };
    private EditForm? _form;
    private IReadOnlyDictionary<int, string> _rateTypes = new Dictionary<int, string>();
    private bool _saving;

    private IEnumerable<KeyValuePair<int, string>> RateTypeOptions
        => _rateTypes.OrderBy(option => option.Value, StringComparer.CurrentCultureIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        var result = await RateTypeService.GetLookupAsync();
        if (result.Successful && result.Value != null)
            _rateTypes = result.Value;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_saving)
            return;

        if (_form?.EditContext?.Validate() != true)
            return;

        _saving = true;

        try
        {
            var result = await TenantRateService.CreateAsync(_model);
            if (result.Successful && result.Value is TenantRate rate)
            {
                MudDialog.Close(DialogResult.Ok(rate));
                return;
            }

            Snackbar.Add(Describe(result, "The rate could not be added."), Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string Describe(Result result, string fallback)
        => result.Errors.FirstOrDefault()
            ?? (!string.IsNullOrWhiteSpace(result.Message) ? result.Message : fallback);
}
