@inject ITenantRateService TenantRateService
@inject ISnackbar Snackbar

@* A minimal rate capture for the invoice editor. The caller supplies the invoice's
   contact/company and, when the line already has one, the rate type and amount. *@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Add a rate</MudText>
    </TitleContent>
    <DialogContent>
        <TenantRateForm @ref="_form" Model="_model"
                        RateTypes="RateTypes" Companies="Companies" Contacts="Contacts"
                        ShowTax="ShowTax" TaxRate="TaxRate"
                        MinorUnits="MinorUnits" CurrencySymbol="@CurrencySymbol"
                        Disabled="_saving" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_saving">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving">
            @(_saving ? "Saving..." : "Add rate")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public short? RateTypeID { get; set; }
    [Parameter] public int? ContactID { get; set; }
    [Parameter] public int? CompanyID { get; set; }
    [Parameter] public decimal? RateIncl { get; set; }

    [Parameter] public IReadOnlyDictionary<int, string>? RateTypes { get; set; }
    [Parameter] public IReadOnlyDictionary<int, string>? Companies { get; set; }
    [Parameter] public IReadOnlyDictionary<int, string>? Contacts { get; set; }

    [Parameter] public bool ShowTax { get; set; }
    [Parameter] public decimal TaxRate { get; set; }
    [Parameter] public int MinorUnits { get; set; } = 2;
    [Parameter] public string CurrencySymbol { get; set; } = "R";

    private TenantRate _model = new();
    private TenantRateForm? _form;
    private bool _saving;

    protected override void OnInitialized()
    {
        _model = new TenantRate
        {
            RateTypeID = RateTypeID ?? 0,
            ContactID = ContactID,
            CompanyID = CompanyID,
            RateIncl = RateIncl
        };
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_saving)
            return;

        if (_form?.Validate() != true)
            return;

        _saving = true;

        try
        {
            var result = await TenantRateService.CreateAsync(_model);
            if (result.Successful && result.Value is TenantRate rate)
            {
                MudDialog.Close(DialogResult.Ok(rate));
                return;
            }

            Snackbar.Add(Describe(result, "The rate could not be added."), Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"The rate could not be added: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string Describe(Result result, string fallback)
        => result.Errors.FirstOrDefault()
            ?? (!string.IsNullOrWhiteSpace(result.Message) ? result.Message : fallback);
}
