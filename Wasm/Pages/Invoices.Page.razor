@page "/invoices"
@using _0nline.Biller.DL.Contract.Enums

@inject IInvoiceService InvoiceService
@inject IContactService ContactService
@inject IInvoiceStatusService InvoiceStatusService
@inject NavigationManager Navigation

<PageTitle>e-Biller | Invoices</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudText Typo="Typo.h3" Class="py-2">Invoices</MudText>

        <MudPaper Class="py-3 px-3">
            @if (_loading)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="my-4 d-block mx-auto" />
            }
            else if (_loadError != null)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="my-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText>@_loadError</MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ReloadAsync">Try again</MudButton>
                    </MudStack>
                </MudAlert>
            }
            else
            {
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
                    <MudText Typo="Typo.body2">
                        The invoices you have issued, newest first. Open one to edit its draft or view its preview.
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="CreateNew">
                        New invoice
                    </MudButton>
                </MudStack>

                @if (_totalCount == 0)
                {
                    <MudText Typo="Typo.body2">
                        No invoices yet. Create one to send your first bill.
                    </MudText>
                }
                else
                {
                    <MudPaper Outlined="true" Elevation="0">
                        @for (int i = 0; i < _invoices.Count; i++)
                        {
                            var invoice = _invoices[i];

                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center"
                                      Class="px-4 py-3">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.subtitle2">@(invoice.InvoiceNumber ?? "Draft")</MudText>
                                    <MudText Typo="Typo.body2">@CustomerName(invoice)</MudText>
                                </MudStack>

                                <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">

                                    <MudText Typo="Typo.body2">@FormatDate(invoice.InvoiceDate)</MudText>

                                    <InvoiceStatusChip Status="(InvoiceStatus)invoice.InvoiceStatusID" />

                                    @if (invoice.theInvoiceStatus == default || invoice.theInvoiceStatus == InvoiceStatus.Draft)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" 
                                                       aria-label="Edit invoice" OnClick="@(() => Open(invoice))" />
                                    }
                                    else
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"
                                                       aria-label="View invoice" OnClick="@(() => Open(invoice))" />
                                    }
                                </MudStack>
                            </MudStack>

                            @if (i < _invoices.Count - 1)
                            {
                                <MudDivider />
                            }
                        }
                    </MudPaper>

                    @if (_totalPages > 0)
                    {

                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-3">
                            <MudItem>
                                <MudText Typo="Typo.body2">@PageSummary()</MudText>
                            </MudItem>
                            <MudItem>
                                <MudPagination Count="_totalPages"
                                               Selected="_page"
                                               SelectedChanged="OnPageChanged"
                                               ShowFirstButton="@(_totalPages > 2)"
                                               ShowLastButton="@(_totalPages > 2)"
                                               Size="Size.Small"
                                               Variant="Variant.Filled"
                                               Color="Color.Primary" />
                            </MudItem>
                            <MudItem >
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.body2" >Page Size:</MudText>
                                <MudSelect T="int" Value="_pageSize" ValueChanged="ChangePageSizeAsync" Margin="Margin.Dense"
                                           Dense="true" Variant="Variant.Text" Style="max-width: 120px;">
                                    @foreach (var size in PageSizeOptions)
                                    {
                                        <MudSelectItem T="int" Value="size">@($"{size} items")</MudSelectItem>
                                    }
                                </MudSelect>
                                </MudStack>
                            </MudItem>
                        </MudStack>

                    }
                }
            }
        </MudPaper>
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@code {
    private const string LoadErrorMessage = "We could not load your invoices. Please try again.";

    private static readonly int[] PageSizeOptions = { 5, 10, 25, 50 };

    private List<Invoice> _invoices = new();
    private IReadOnlyDictionary<int, string> _contacts = new Dictionary<int, string>();
    private IReadOnlyDictionary<int, string> _statuses = new Dictionary<int, string>();

    private int _page = 1;
    private int _pageSize = 10;
    private int _totalCount;
    private int _totalPages;

    private bool _loading = true;
    private string? _loadError;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        _loadError = null;

        try
        {
            var invoicesTask = InvoiceService.GetRecentPageAsync(_page, _pageSize);
            var contactsTask = ContactService.GetLookupAsync();
            var statusesTask = InvoiceStatusService.GetLookupAsync();

            await Task.WhenAll(invoicesTask, contactsTask, statusesTask);

            var invoices = await invoicesTask;
            var contacts = await contactsTask;
            var statuses = await statusesTask;

            if (!invoices.Successful || invoices.Value is not PageOf<Invoice> result)
            {
                _loadError = Describe(invoices, LoadErrorMessage);
                return;
            }

            _invoices = result.Items.ToList();
            _totalCount = result.TotalCount;
            _totalPages = result.TotalPages;
            _contacts = contacts.Successful && contacts.Value != null ? contacts.Value : _contacts;
            _statuses = statuses.Successful && statuses.Value != null ? statuses.Value : _statuses;
        }
        catch (Exception ex)
        {
            _loadError = $"{LoadErrorMessage} ({ex.Message})";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ChangePageSizeAsync(int pageSize)
    {
        _pageSize = pageSize;
        _page = 1;
        await ReloadAsync();
    }

    private async Task OnPageChanged(int page)
    {
        // MudPagination also reports the value it is re-rendered with. A page-size
        // change has already reset the page and loaded it, so only a real move
        // needs another round trip.
        if (page == _page)
            return;

        _page = page;
        await ReloadAsync();
    }

    private string PageSummary()
    {
        if (_totalCount == 0)
            return string.Empty;

        var first = (_page - 1) * _pageSize + 1;
        var last = Math.Min(_page * _pageSize, _totalCount);
        if (first == last)
            return $"Showing {first} of {_totalCount}";
        else
            return $"Showing {first}-{last} of {_totalCount}";
    }

    private void CreateNew() => Navigation.NavigateTo("/invoice/0");

    private void Open(Invoice invoice) => Navigation.NavigateTo($"/invoice/{invoice.ID}");

    private string CustomerName(Invoice invoice)
        => invoice.IssuedToContactID > 0 && _contacts.TryGetValue(invoice.IssuedToContactID, out var name)
            ? name
            : "No contact";

    private string StatusName(Invoice invoice)
        => _statuses.TryGetValue(invoice.InvoiceStatusID, out var name) ? name : "Draft";

    private static string? FormatDate(DateTime? date) => date?.ToString("MMM d, yyyy");

    private static string Describe(Result result, string fallback)
        => result.Errors.FirstOrDefault()
            ?? (!string.IsNullOrWhiteSpace(result.Message) ? result.Message : fallback);
}
