@page "/tenant"
@using _0nline.Biller.Wasm.Components
@using _0nline.Biller.DL.Contract.Models
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject ITenantService TenantService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserSession UserSession

<PageTitle>e-Biller | My Profile</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="my-8 d-block mx-auto" />
}
else if (_loadError != null)
{
    <MudAlert Severity="Severity.Error" Class="my-6" Variant="Variant.Outlined">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText>@_loadError</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Reload">Try again</MudButton>
        </MudStack>
    </MudAlert>
}
else if (_onboarding)
{
    <MudText Typo="Typo.h3" Class="py-3 mb-1">Get Started:</MudText>
    <MudPaper Class="pa-3">
        <TenantForm Onboarding="true" Tenant="@_tenant" OnSaved="OnSaved" />
    </MudPaper>
}
else
{
    <MudPaper Class="py-3 px-3">
        <TenantForm Tenant="@_tenant" OnSaved="OnSaved" />
    </MudPaper>
}


@code {

    private bool _loading = true;
    private bool _onboarding;
    private string? _loadError;
    private Tenant? _tenant;

    /// <summary>
    /// The tenant is created on first login (ensure), so "onboarding" is now a
    /// profile question: has the tenant been pointed at its own contact and
    /// company yet?
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _loadError = null;
        _tenant = null;

        if (!UserSession.UserId.HasValue)
        {
            // <AuthorizeView> is already redirecting; don't render a form with no tenant.
            _loadError = "Please sign in to continue.";
            _loading = false;
            return;
        }

        if (UserSession.TenantId > 0)
        {
            var result = await TenantService.GetOneAsync(UserSession.TenantId);

            if (result.Successful && result.Value is Tenant existing)
            {
                SetTenant(existing);
            }
            else if (result.IsNone || result.ErrorCode == ErrorCode.Unauthorized)
            {
                // The session may still be pointing at a tenant that no longer
                // exists or was closed. Clear it and let ensure start a new one.
                UserSession.UpdateTenant(0);
            }
            else
            {
                _loadError = Describe(result);
            }
        }

        if (_tenant == null && _loadError == null)
        {
            // First login, or a session without a tenantId claim: create the
            // minimal tenant and get a token that carries it.
            var ensured = await TenantService.EnsureAsync();

            if (ensured.Successful && ensured.Value is TenantRegistrationResult registration)
            {
                // A form whose writes would be rejected for a missing tenantId
                // claim is worse than an explicit retry.
                if (string.IsNullOrEmpty(registration.Token) && UserSession.TenantId <= 0)
                {
                    _loadError = "Your session could not be linked to a workspace. Please sign in again.";
                    _loading = false;
                    return;
                }

                if (!string.IsNullOrEmpty(registration.Token)
                    && AuthStateProvider is _0nline.Biller.Wasm.Client.Auth.JwtAuthStateProvider jwtProvider)
                {
                    await jwtProvider.NotifyUserAuthenticationAsync(registration.Token);
                }

                // Re-read with the new token so the logo/image augment runs; the
                // ensure response was loaded without a tenant claim.
                var loaded = await TenantService.GetOneAsync(registration.Tenant.ID);
                if (loaded.Successful && loaded.Value is Tenant augmented)
                    SetTenant(augmented);
                else
                    SetTenant(registration.Tenant);
            }
            else if (ensured.IsNone)
            {
                // A tenant is created on first login, so "no tenant" is an error,
                // not an onboarding state. The form needs a real tenant id.
                _loadError = "Your workspace could not be created. Please try again.";
            }
            else
            {
                _loadError = Describe(ensured);
            }
        }

        _loading = false;
    }

    private void SetTenant(Tenant tenant)
    {
        _tenant = tenant;
        UserSession.UpdateTenant(tenant.ID);
        _onboarding = tenant.ContactID is null || tenant.CompanyID is null;
    }

    private static string Describe(Result result)
        => result.Errors.FirstOrDefault()
            ?? (!string.IsNullOrWhiteSpace(result.Message)
                ? result.Message
                : "We could not load your profile. Please try again.");

    private async Task Reload()
    {
        _loading = true;
        StateHasChanged();
        await OnInitializedAsync();
    }

    private void OnSaved(Tenant tenant)
    {
        bool wasOnboarding = _onboarding;

        _tenant = tenant;
        _onboarding = tenant.ContactID is null || tenant.CompanyID is null;

        if (_onboarding)
        {
            Snackbar.Add("Profile saved, but it is not attached to the workspace yet.", Severity.Warning);
        }
        else
        {
            Snackbar.Add("Tenant profile saved successfully.", Severity.Success);

            if (wasOnboarding)
                Nav.NavigateTo("/");
        }
    }
}
